  "rows": [
    {
      "number": 1,
      "title": "乾",
      "judgment": "《乾》元亨，利貞。",
      "lines": [
        "初九、潛龍勿用。",
        "九二：見龍在田，利見大人。",
        "九三：君子終日乾乾，夕惕若厲。无咎。",
        "九四：或躍在淵，无咎。",
        "九五：飛龍在天，利見大人。",
        "上九：亢龍，有悔。"
      ],
      "extras": [
        "用九：見群龍无首，吉。"
      ],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_001.txt",
      "sourceSha256": "ce3b0074441a31f2756d7b7c8687e7d25d2cdecb6c97a7c744d2879d7bcc430f"
    },
    {
      "number": 2,
      "title": "坤",
      "judgment": "《坤》元亨。利牝馬之貞。君子有攸往，先迷後得主，利，西南得朋，東北喪朋。安貞吉。",
      "lines": [
        "初六：履霜、堅冰至。",
        "六二：直、方、大，不習无不利。",
        "六三：含章可貞，或從王事，无成有終。",
        "六四：括囊，无咎无譽。",
        "六五：黃裳元吉。",
        "上六：龍戰于野，其血玄黃。"
      ],
      "extras": [
        "用六：利永貞。"
      ],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_002.txt",
      "sourceSha256": "aecc28f8cd433f983b5e180f7fbc47afd6a95753df2e0b76bfae3b37c1847b8e"
    },
    {
      "number": 3,
      "title": "屯",
      "judgment": "《屯》元亨，利貞。勿用有攸往。利建侯。",
      "lines": [
        "初九：磐桓。利居貞。利建侯。",
        "六二：屯如邅如，乘馬班如。匪寇，婚媾。女子貞不字，十年乃字。",
        "六三：即鹿無虞，惟入于林中，君子幾不如舍，往吝。",
        "六四：乘馬班如，求婚媾。往吉，无不利。",
        "九五：屯其膏，小貞吉，大貞凶。",
        "上六：乘馬班如，泣血漣如。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_003.txt",
      "sourceSha256": "beb830994a19507d9b344d686bc5c627861b7956c3a49f57473204964edc7f2b"
    },
    {
      "number": 4,
      "title": "蒙",
      "judgment": "《蒙》亨。匪我求童蒙，童蒙來求我。初筮告，再三瀆，瀆則不告。利貞。",
      "lines": [
        "初六：發蒙，利用刑人，用說桎梏，以往吝。",
        "九二：苞蒙，吉。納婦吉。子克家。",
        "六三：勿用取女，見金夫，不有躬。无攸利。",
        "六四：困蒙，吝。",
        "六五：童蒙，吉。",
        "上九：擊蒙，不利為寇，利禦寇。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_004.txt",
      "sourceSha256": "5311e2c1b0256a844504c73d3ee39fbbed30f0e1a59bec846b12ea53e0585067"
    },
    {
      "number": 5,
      "title": "需",
      "judgment": "《需》有孚，光亨。貞吉。利涉大川。",
      "lines": [
        "初九：需于郊，利用恆，无咎。",
        "九二：需于沙，小有言，終吉。",
        "九三：需于泥，致寇至。",
        "六四：需于血，出自穴。",
        "九五：需于酒食，貞吉。",
        "上六：入于穴，有不速之客三人來，敬之終吉。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_005.txt",
      "sourceSha256": "c4ed7071cbddfae5ef7b9d233a5d794bb22f37ba599f227b7d941e9df6fbedfe"
    },
    {
      "number": 6,
      "title": "訟",
      "judgment": "《訟》有孚窒，惕，中吉，終凶。利見大人。不利涉大川。",
      "lines": [
        "初六：不永所事，小有言，終吉。",
        "九二：不克訟，歸而逋其邑，人三百戶无眚。",
        "六三：食舊德，貞厲，終吉。或從王事无成。",
        "九四：不克訟，復即命，渝。安貞吉。",
        "九五：訟元吉。",
        "上九：或錫之鞶、帶，終朝三褫之。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_006.txt",
      "sourceSha256": "2f46d13c523df456809377b2a10359fe4db7c10cbed983ed07112431733da050"
    },
    {
      "number": 7,
      "title": "師",
      "judgment": "《師》貞丈人吉，无咎。",
      "lines": [
        "初六：師出以律，否臧凶。",
        "九二：在師中，吉、无咎，王三錫命。",
        "六三：師或輿尸，凶。",
        "六四：師左次，无咎。",
        "六五：田有禽。利執言，无咎。長子帥師，弟子輿尸，貞凶。",
        "上六：大君有命，開國承家，小人勿用。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_007.txt",
      "sourceSha256": "779e5924ebc6c53707dc610eac68ffe8d1a7b18ac4f5f98d8a88a9b066f532c7"
    },
    {
      "number": 8,
      "title": "比",
      "judgment": "《比》吉。原筮元，永貞无咎。不寧方來，後夫凶。",
      "lines": [
        "初六：有孚比之，无咎。有孚盈缶，終來，有它吉。",
        "六二：比之自內，貞吉。",
        "六三：比之匪人。",
        "六四：外比之，貞吉。",
        "九五：顯比，王用三驅，失前禽，邑人不誡，吉。",
        "上六：比之无首，凶。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_008.txt",
      "sourceSha256": "9ddc182af90558e3b957e7728a24102905a84bce7ea9ee8ba9b05d66400d8438"
    },
    {
      "number": 9,
      "title": "小畜",
      "judgment": "《小畜》亨。密雲不雨，自我西郊。",
      "lines": [
        "初九：復自道，何其咎，吉。",
        "九二：牽復，吉。",
        "九三：輿說輻。夫妻反目。",
        "六四：有孚血去惕出，无咎。",
        "九五：有孚攣如，富以其鄰。",
        "上九：既雨既處，尚德載。婦貞厲。月幾望，君子征凶。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_009.txt",
      "sourceSha256": "fa269d162868f183d4744fcf8a6f249a57312bef5764bb005c22046610144948"
    },
    {
      "number": 10,
      "title": "履",
      "judgment": "《履》履虎尾，不咥人。亨。",
      "lines": [
        "初九：素履往，无咎。",
        "九二：履道坦坦，幽人貞吉。",
        "六三：眇能視，跛能履，履虎尾，咥人凶。武人為于大君。",
        "九四：履虎尾愬愬，終吉。",
        "九五：夬履貞厲。",
        "上九：視履考祥，其旋，元吉。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_010.txt",
      "sourceSha256": "d6c93349b6011e243843d82ea0de1d32181d85ad24892d0092d2435a9d1a31a6"
    },
    {
      "number": 11,
      "title": "泰",
      "judgment": "《泰》小往大來，吉，亨。",
      "lines": [
        "初九：拔茅茹以其彙。征吉。",
        "九二：苞荒，用馮河，不遐遺。朋亡，得尚于中行。",
        "九三：无平不陂，无往不復。艱貞，无咎。勿恤其孚，于食有福。",
        "六四：翩翩，不富以其鄰，不戒以孚。",
        "六五：帝乙歸妹，以祉，元吉。",
        "上六：城復于隍，勿用師，自邑告命、貞吝。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_011.txt",
      "sourceSha256": "851c2b2320f0069c9a7cd71e3a5201432a51ff3d0f6dbbb25ec4c9cb5c201f56"
    },
    {
      "number": 12,
      "title": "否",
      "judgment": "《否》否之匪人。不利君子貞。大往小來。",
      "lines": [
        "初六：拔茅茹，以其彙。貞吉亨。",
        "六二：苞承，小人吉，大人否。亨。",
        "六三：苞羞。",
        "九四：有命，无咎，疇離祉。",
        "九五：休否，大人吉。其亡其亡，繫于苞桑。",
        "上九：傾否，先否後喜。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_012.txt",
      "sourceSha256": "db30ab2d6eb8db39953a12df5649eea7acac527be556cbe2ebb88e00c97be915"
    },
    {
      "number": 13,
      "title": "同人",
      "judgment": "《同人》同人于野，亨。利涉大川。利君子貞。",
      "lines": [
        "初九：同人于門，无咎。",
        "六二：同人于宗，吝。",
        "九三：伏戎于莽，升其高陵，三歲不興。",
        "九四：乘其墉，弗克攻，吉。",
        "九五：同人先號咷而後笑，大師克，相遇。",
        "上九：同人于郊，无悔。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_013.txt",
      "sourceSha256": "509bcc32c50aecdee4909b071c511aab709f263e12ba59ce6057afc4017e4ffe"
    },
    {
      "number": 14,
      "title": "大有",
      "judgment": "《大有》元亨。",
      "lines": [
        "初九：无交害，匪咎、艱則无咎。",
        "九二：大車以載，有攸往，无咎。",
        "九三：公用亨于天子，小人弗克。",
        "九四：匪其彭，无咎。",
        "六五：厥孚交如，威如吉。",
        "上九：自天祐之，吉无不利。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_014.txt",
      "sourceSha256": "31de6184aa4d3bcb6fd57f7d96c5019eb50a0c4759dda52961a689c84f6fb658"
    },
    {
      "number": 15,
      "title": "謙",
      "judgment": "《謙》亨。君子有終。",
      "lines": [
        "初六：謙謙君子，用涉大川，吉。",
        "六二：鳴謙，貞吉。",
        "九三：勞謙，君子有終、吉。",
        "六四：无不利，撝謙。",
        "六五：不富以其鄰，利用侵伐，无不利。",
        "上六：鳴謙，利用行師征邑國。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_015.txt",
      "sourceSha256": "492b3272e9a266c2ff8d8045d03ac5abd0576e79e26fef8d4c5de85786be46e6"
    },
    {
      "number": 16,
      "title": "豫",
      "judgment": "《豫》利建侯行師。",
      "lines": [
        "初六：鳴豫，凶。",
        "六二：介于石，不終日，貞吉。",
        "六三：盱豫，悔，遲有悔。",
        "九四：由豫，大有得，勿疑。朋盍簪。",
        "六五：貞疾，恆不死。",
        "上六：冥豫成，有渝、无咎。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_016.txt",
      "sourceSha256": "318d2af66d1c42d5372b691f57953045be7317af5b939b9a13460573e95e6d4d"
    },
    {
      "number": 17,
      "title": "隨",
      "judgment": "《隨》元亨，利貞，无咎。",
      "lines": [
        "初九：官有渝，貞吉，出門交有功。",
        "六二：係小子，失丈夫。",
        "六三：係丈夫，失小子，隨有求、得。利居貞。",
        "九四：隨有獲，貞凶。有孚在道，以明，何咎？",
        "九五：孚于嘉、吉。",
        "上六：拘係之乃從，維之，王用亨于西山。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_017.txt",
      "sourceSha256": "0fb0ebf371f1299949266fda19927e273e7e1e024307f5bb070330cf61271891"
    },
    {
      "number": 18,
      "title": "蠱",
      "judgment": "《蠱》元亨。利涉大川，先甲三日，後甲三日。",
      "lines": [
        "初六：幹父之蠱，有子，考无咎，厲終吉。",
        "九二：幹母之蠱，不可貞。",
        "九三：幹父之蠱，小有悔，无大咎。",
        "六四：裕父之蠱，往見吝。",
        "六五：幹父之蠱，用譽。",
        "上九：不事王侯，高尚其事。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_018.txt",
      "sourceSha256": "43fd6d5cd8f324ee3f606f503af4782896fa75a6ee5696f22d0595826b362945"
    },
    {
      "number": 19,
      "title": "臨",
      "judgment": "《臨》元亨，利貞。至于八月有凶。",
      "lines": [
        "初九：咸臨，貞吉。",
        "九二：咸臨吉，无不利。",
        "六三：甘臨，无攸利；既憂之，无咎。",
        "六四：至臨，无咎。",
        "六五：知臨，大君之宜，吉。",
        "上六：敦臨吉，无咎。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_019.txt",
      "sourceSha256": "211a66d87eaa83ac3cfcfc96e8b0e5d46c18bb16d2daf8a5e47f46d5265deab7"
    },
    {
      "number": 20,
      "title": "觀",
      "judgment": "《觀》盥而不薦。有孚顒若。",
      "lines": [
        "初六：童觀，小人无咎，君子吝。",
        "六二：闚觀，利女貞。",
        "六三：觀我生進退。",
        "六四：觀國之光，利用賓于王。",
        "九五：觀我生，君子无咎。",
        "上九：觀其生，君子无咎。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_020.txt",
      "sourceSha256": "4b06c9b29dcbf244ffe466f7684035f7a7deb6c8ec8b8f569bf2e069e464229d"
    },
    {
      "number": 21,
      "title": "噬嗑",
      "judgment": "《噬嗑》亨。利用獄。",
      "lines": [
        "初九：屨校滅趾，无咎。",
        "六二：噬膚滅鼻，无咎。",
        "六三：噬腊肉遇毒，小吝，无咎。",
        "九四：噬乾胏，得金矢。利艱貞、吉。",
        "六五：噬乾肉，得黃金。貞厲无咎。",
        "上九：何校滅耳，凶。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_021.txt",
      "sourceSha256": "67381d9f634a844e77de7affda8aacc5e1a9b97267f625f5dfa04c77c2a365f4"
    },
    {
      "number": 22,
      "title": "賁",
      "judgment": "《賁》亨。小利有攸往。",
      "lines": [
        "初九：賁其趾，舍車而徒。",
        "六二：賁其須。",
        "九三：賁如濡如，永貞吉。",
        "六四：賁如皤如，白馬翰如，匪寇，婚媾。",
        "六五：賁于丘園，束帛戔戔，吝終吉。",
        "上九：白賁，无咎。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_022.txt",
      "sourceSha256": "386d3f18809d56c0b8281cc1887cad04e9036f920ecc0fdbfb64c8361bdd601f"
    },
    {
      "number": 23,
      "title": "剝",
      "judgment": "《剝》不利有攸往。",
      "lines": [
        "初六：剝床以足，蔑貞凶。",
        "六二：剝床以辨，蔑貞凶。",
        "六三：剝之无咎。",
        "六四：剝床以膚，凶。",
        "六五：貫魚以宮人寵，无不利。",
        "上九：碩果不食，君子得輿，小人剝廬。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_023.txt",
      "sourceSha256": "05fdfcdd667a280767841d5067e5e10d0e6ba9ac2eae1c377fd692dcc18c9cfe"
    },
    {
      "number": 24,
      "title": "復",
      "judgment": "《復》亨。出入无疾。朋來无咎。反復其道，七日來復。利有攸往。",
      "lines": [
        "初九：不遠復，无祗悔，元吉。",
        "六二：休復，吉。",
        "六三：頻復，厲、无咎。",
        "六四：中行獨復。",
        "六五：敦復，无悔。",
        "上六：迷復，凶，有災眚。用行師，終有大敗，以其國君凶，至于十年不克征。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_024.txt",
