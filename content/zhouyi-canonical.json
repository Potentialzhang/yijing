    },
    {
      "number": 39,
      "title": "蹇",
      "judgment": "《蹇》利西南，不利東北。利見大人。貞吉。",
      "lines": [
        "初六：往蹇來譽。",
        "六二：王臣蹇蹇，匪躬之故。",
        "九三：往蹇來反。",
        "六四：往蹇來連。",
        "九五：大蹇，朋來。",
        "上六：往蹇，來碩，吉，利見大人。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_039.txt",
