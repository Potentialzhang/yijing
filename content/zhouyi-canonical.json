    },
    {
      "number": 37,
      "title": "家人",
      "judgment": "《家人》利女貞。",
      "lines": [
        "初九：閑有家，悔亡。",
        "六二：无攸遂，在中饋，貞吉。",
        "九三：家人嗃嗃，悔厲，吉；婦子嘻嘻，終吝。",
        "六四：富家，大吉。",
        "九五：王假有家，勿恤，吉。",
        "上九：有孚威如，終吉。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_037.txt",
