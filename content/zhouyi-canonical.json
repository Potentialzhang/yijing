    },
    {
      "number": 34,
      "title": "大壯",
      "judgment": "《大壯》利貞。",
      "lines": [
        "初九：壯于趾，征凶有孚。",
        "九二：貞吉。",
        "九三：小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。",
        "九四：貞吉，悔亡。藩決不羸，壯于大輿之輹。",
        "六五：喪羊于易，无悔。",
        "上六：羝羊觸藩，不能退，不能遂，无攸利，艱則吉。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_034.txt",
