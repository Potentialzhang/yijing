    },
    {
      "number": 25,
      "title": "无妄",
      "judgment": "《无妄》元亨，利貞。其匪正有眚，不利有攸往。",
      "lines": [
        "初九：无妄，往吉。",
        "六二：不耕穫；不菑畬；則利有攸往。",
        "六三：无妄之災，或繫之牛，行人之得，邑人之災。",
        "九四：可貞，无咎。",
        "九五：无妄之疾，勿藥有喜。",
        "上九：无妄，行有眚，无攸利。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_025.txt",
      "sourceSha256": "bd3c37f6cf5789c982cc08060040a0dd9645a3437faacbfe001585585f5d1825"
    },
    {
      "number": 26,
      "title": "大畜",
      "judgment": "《大畜》利貞。不家食吉。利涉大川。",
      "lines": [
        "初九：有厲，利己。",
        "九二：輿說輹。",
        "九三：良馬逐，利艱貞，曰閑輿衛，利有攸往。",
        "六四：童牛之牿，元吉。",
        "六五：豶豕之牙，吉。",
        "上九：何天之衢，亨。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_026.txt",
      "sourceSha256": "29b2c0ca681a6045727b02dc831a3644ff31ddbe5dd5f2e286bb0ea58681c503"
    },
    {
      "number": 27,
      "title": "頤",
      "judgment": "《頤》貞吉。觀頤，自求口實。",
      "lines": [
        "初九：舍爾靈龜，觀我朵頤，凶。",
        "六二：顛頤，拂經于丘，頤、征凶。",
        "六三：拂頤貞、凶，十年勿用，无攸利。",
        "六四：顛頤，吉。虎視眈眈，其欲逐逐，无咎。",
        "六五：拂經，居貞、吉，不可涉大川。",
        "上九：由頤，厲、吉。利涉大川。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_027.txt",
      "sourceSha256": "86798a930c4a92658a39f87447a5edcd3636a3a10883d3d6b7b192c8b3060cf5"
    },
    {
      "number": 28,
      "title": "大過",
      "judgment": "《大過》棟橈，利有攸往，亨。",
      "lines": [
        "初六：藉用白茅，无咎。",
        "九二：枯楊生稊，老夫得其女妻，无不利。",
        "九三：棟橈，凶。",
        "九四：棟隆、吉。有它、吝。",
        "九五：枯楊生華，老婦得其士夫，无咎无譽。",
        "上六：過涉滅頂，凶。无咎。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_028.txt",
      "sourceSha256": "70bb9bd33de55b6ae4e7b1f69427a0dd3768ae9213260d2ccb77c9296a90d411"
    },
    {
      "number": 29,
      "title": "習坎",
      "judgment": "《習坎》有孚，維心、亨。行有尚。",
      "lines": [
        "初六：習坎，入于坎窞，凶。",
        "九二：坎有險，求小得。",
        "六三：來之坎坎，險且枕，入于坎窞，勿用。",
        "六四：樽酒、簋貳、用缶，納約自牖，終无咎。",
        "九五：坎不盈，衹既平，无咎。",
        "上六：係用徽纆，寘于叢棘，三歲不得，凶。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_029.txt",
