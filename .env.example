# Docker 部署
YIJING_IMAGE=yijing-app:local
YIJING_CONTAINER=yijing-app
YIJING_PORT=3000
# 0.0.0.0 允许局域网访问；仅本机使用可改为 127.0.0.1
YIJING_BIND=0.0.0.0
# 浏览器访问源；局域网测试可留空，生产反向代理建议填写完整 origin。
APP_ORIGIN=
# HTTPS 反向代理下设为 1；局域网 HTTP 测试保持 0，避免浏览器拒收会话 Cookie。
AUTH_COOKIE_SECURE=0

# 本地测试环境
LOCAL_TEST_HOST=127.0.0.1
LOCAL_TEST_PORT=3000

# PostgreSQL（docker compose 会自动启动数据库并执行增量迁移）
POSTGRES_DB=yijing
POSTGRES_USER=yijing
POSTGRES_PASSWORD=change-me-in-env
DATABASE_URL=postgresql://yijing:change-me-in-env@db:5432/yijing

# AI 辅学：仅服务端读取，不要使用 NEXT_PUBLIC_ 前缀。
OPENAI_API_KEY=
# 填写你的 API 账户可访问、支持 Responses 与结构化输出的模型 ID。
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# 反向代理部署时设置浏览器访问地址，例如 https://yijing.example.com
AI_ALLOWED_ORIGIN=
