    },
    {
      "number": 31,
      "title": "咸",
      "judgment": "《咸》亨。利貞。取女吉。",
      "lines": [
        "初六：咸其拇。",
        "六二：咸其腓，凶。居吉。",
        "九三：咸其股，執其隨，往吝。",
        "九四：貞吉。悔亡。憧憧往來，朋從爾思。",
        "九五：咸其脢，无悔。",
        "上六：咸其輔頰舌。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_031.txt",
