    },
    {
      "number": 33,
      "title": "遯",
      "judgment": "《遯》亨。小利貞。",
      "lines": [
        "初六：遯尾、厲，勿用有攸往。",
        "六二：執之用黃牛之革，莫之勝、說。",
        "九三：係遯，有疾厲，畜臣妾吉。",
        "九四：好遯，君子吉，小人否。",
        "九五：嘉遯，貞吉。",
        "上九：肥遯，无不利。"
      ],
      "extras": [],
      "sourceUrl": "https://github.com/kanripo/KR1a0001/blob/8284adbf9e3435d713180e24f05bf75f8b7d1d96/KR1a0001_033.txt",
