{
  "name": "yijing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm test -- --run",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-quality.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:e2e:prod": "node scripts/run-production-e2e.mjs",
    "test:e2e:prod:chromium": "node scripts/run-production-e2e.mjs --project=chromium --workers=2",
    "test:e2e:prod:webkit": "node scripts/run-production-e2e.mjs --project=webkit --workers=1",
    "test:e2e:prod:firefox": "PLAYWRIGHT_PROD_BROWSER=firefox node scripts/run-production-e2e.mjs --project=firefox --workers=1",
    "test:e2e:firefox": "node scripts/run-firefox-tests.mjs",
    "test:a11y": "playwright test tests/a11y.spec.ts --project=chromium --project=webkit --workers=1",
    "test:perf": "playwright test tests/e2e/performance.spec.ts --project=chromium --project=webkit",
    "test:responsive": "playwright test tests/e2e/responsive.spec.ts --project=chromium --project=webkit",
    "test:mobile": "playwright test --config=playwright.mobile.config.ts --workers=1",
    "test:mobile:prod": "MOBILE_E2E_PRODUCTION=1 playwright test --config=playwright.mobile.config.ts --workers=1",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:data": "node scripts/verify-data-reliability.mjs",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:container": "node scripts/test-container.mjs",
    "deploy": "node scripts/deploy.mjs",
    "local:test": "node scripts/local-test.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "lunar-typescript": "1.8.6",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
